# ==========================================
# Coyote AI 控制器环境变量配置示例 (请复制并重命名为 .env)
# ==========================================

# ------------------------------------------
# 1. AI 模型提供商与 API Key 配置
# ------------------------------------------
# DeepSeek API (国内直连极速，默认不使用代理)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------
# 2. 网络代理细粒度配置 (服务级按需分流，零硬编码)
# ------------------------------------------
# Gemini 专属代理 (访问谷歌必须翻墙，如 Clash 填 http://127.0.0.1:7890，留空则尝试直连)
GEMINI_PROXY=http://127.0.0.1:7890

# DeepSeek 专属代理 (留空表示直接连通国内 API，极速低延迟；特殊海外网络可单独配置)
DEEPSEEK_PROXY=

# 全局备用代理 (若上述服务未单独配置代理，且设置了此项，则作为默认后备；可留空)
GLOBAL_PROXY=

# ------------------------------------------
# 3. 服务端监听与网络拓扑配置 (支持局域网/多域名自适应)
# ------------------------------------------
HOST=0.0.0.0
WS_PORT=54321
HTTPS_PORT=443
# HTTP 端口 (默认 80 重定向到 HTTPS；若 DISABLE_SSL=true 则直接作为 Web 主服务端口)
HTTP_PORT=80
# 备用回退域名 (当客户端未传递 Host 标头时的默认回退)
DOMAIN=coyote.example.com

# ------------------------------------------
# 4. SSL 证书与自动化策略 (多层级弹性降级)
# ------------------------------------------
# 是否完全禁用 SSL (true: 纯明文 HTTP/WS 模式，零证书负担；false: 启用 SSL 加密)
DISABLE_SSL=false

# 是否允许在缺少公网证书/未配 CF 时自动生成局域网自签名证书 (true/false)
ALLOW_SELF_SIGNED=true

# 证书自动续期阈值天数 (小于该天数自动触发续期)
SSL_RENEW_DAYS=7

# Let's Encrypt 申请域名列表 (逗号分隔，仅在配置了 Cloudflare 凭据时生效)
SSL_DOMAINS=coyote.example.com,*.coyote.example.com

# Cloudflare 凭据 (用于 Let's Encrypt DNS-01 自动签发；留空则回退至自签名或本地证书)
CF_EMAIL=your_cloudflare_email@example.com
CF_API_KEY=your_cloudflare_global_api_key
# CF_ZONE_ID=
